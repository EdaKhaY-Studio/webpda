# ============================================================
# Hostinger Shared Hosting Apache / LiteSpeed Configuration
# Paham Digital Agency (https://pahamdigital.online)
# ============================================================

# Enable Directory Slash
<IfModule mod_dir.c>
    DirectorySlash On
    DirectoryIndex index.html
</IfModule>

# Custom Error Documents (Genuine 404 Not Found & 410 Gone)
ErrorDocument 404 /_not-found/index.html
ErrorDocument 410 /_not-found/index.html

# Rewrite Engine for Canonical Hostname, HTTPS & Clean Static Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------------
    # 01. CANONICAL HOSTNAME & HTTPS REDIRECTS (HTTP 301)
    # Target: https://pahamdigital.online/
    # Preserves path and query string (QSA)
    # ------------------------------------------------------------

    # Rule A: Redirect any www request (HTTP or HTTPS) directly to canonical https://pahamdigital.online/
    RewriteCond %{HTTP_HOST} ^www\.pahamdigital\.online$ [NC]
    RewriteRule ^(.*)$ https://pahamdigital.online/$1 [R=301,L,QSA]

    # Rule B: Force HTTPS for non-www requests
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^pahamdigital\.online$ [NC]
    RewriteRule ^(.*)$ https://pahamdigital.online/$1 [R=301,L,QSA]

    # ------------------------------------------------------------
    # 02. HISTORICAL / DELETED BLOG URL MIGRATIONS & REMOVALS
    # ------------------------------------------------------------
    # Case B: Renamed articles -> Permanent HTTP 301 redirect to closest new equivalent slug
    # "Mengapa UMKM di Aceh Barat Butuh Website Profesional di 2025" -> "Kenapa Bisnis Perlu Website? Manfaatnya untuk UMKM di Era AI"
    RewriteRule ^blog/mengapa-umkm-butuh-website/?$ https://pahamdigital.online/blog/kenapa-bisnis-perlu-website/ [R=301,L]

    # "Panduan Lengkap SEO Lokal untuk Bisnis di Aceh Barat" -> "Cara Agar Website Muncul di Google: Kenali Apa Itu SEO"
    RewriteRule ^blog/panduan-seo-lokal-aceh/?$ https://pahamdigital.online/blog/apa-itu-seo-website-sepi-pengunjung/ [R=301,L]

    # Case A: Permanently deleted articles with no direct equivalent -> HTTP 410 Gone
    # "Bagaimana AI Customer Service Mengubah Cara UMKM Melayani Pelanggan"
    RewriteRule ^blog/ai-customer-service-untuk-umkm/?$ - [G,L]

    # "Automasi Bisnis: Bukan Sekadar Tren, Tapi Kebutuhan Operasional"
    RewriteRule ^blog/automasi-bisnis-bukan-sekedar-tren/?$ - [G,L]

    # ------------------------------------------------------------
    # 03. CLEAN TRAILING-SLASH AND INDEX.HTML NORMALIZATION
    # ------------------------------------------------------------

    # Redirect /index.html directly to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ https://pahamdigital.online/ [R=301,L]

    # Redirect /subpath/index.html to /subpath/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index\.html\ HTTP/
    RewriteRule ^(.*)/index\.html$ https://pahamdigital.online/$1/ [R=301,L]

    # ------------------------------------------------------------
    # 04. SERVE REAL FILES AND DIRECTORIES
    # ------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------
    # 05. NEXT.JS STATIC EXPORT CLEAN ROUTING
    # If path exists as folder with index.html, serve it internally
    # ------------------------------------------------------------
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)/?$ /$1/index.html [L]
</IfModule>

# ------------------------------------------------------------
# 06. CORS & FAVICON ACCESS FOR CRAWLERS
# ------------------------------------------------------------
<FilesMatch "\.(ico|png|svg|json)$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# 07. ZERO-CACHE FOR HTML (Prevents Stale Cache in Edge / Chrome / CDN)
# ------------------------------------------------------------
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# 08. CACHING HEADERS FOR STATIC ASSETS
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/x-icon "access plus 1 hour"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
# 09. SECURITY HEADERS
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
