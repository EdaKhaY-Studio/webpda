# ============================================================
# Hostinger Shared Hosting Apache / LiteSpeed Configuration
# Paham Digital Agency (https://pahamdigital.online)
# ============================================================

# Enable Directory Slash
<IfModule mod_dir.c>
    DirectorySlash On
    DirectoryIndex index.html
</IfModule>

# Custom 404 Error Document
ErrorDocument 404 /_not-found/index.html

# Rewrite Engine for Canonical Hostname, HTTPS & Clean Static Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------------
    # 01. CANONICAL HOSTNAME & HTTPS REDIRECTS (HTTP 301)
    # Target: https://pahamdigital.online/
    # ------------------------------------------------------------

    # Rule A: Redirect www to non-www (both HTTP and HTTPS)
    # Matches www.pahamdigital.online -> https://pahamdigital.online/$1
    RewriteCond %{HTTP_HOST} ^www\.pahamdigital\.online$ [NC]
    RewriteRule ^(.*)$ https://pahamdigital.online/$1 [R=301,L]

    # Rule B: Force HTTPS for non-www
    # Matches http://pahamdigital.online -> https://pahamdigital.online/$1
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://pahamdigital.online/$1 [R=301,L]

    # ------------------------------------------------------------
    # 02. CLEAN TRAILING-SLASH AND INDEX.HTML NORMALIZATION
    # ------------------------------------------------------------

    # Redirect /index.html directly to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ https://pahamdigital.online/ [R=301,L]

    # Redirect /subpath/index.html to /subpath/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index\.html\ HTTP/
    RewriteRule ^(.*)/index\.html$ https://pahamdigital.online/$1/ [R=301,L]

    # ------------------------------------------------------------
    # 03. SERVE REAL FILES AND DIRECTORIES
    # ------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------
    # 04. NEXT.JS STATIC EXPORT CLEAN ROUTING
    # If path exists as folder with index.html, serve it internally
    # ------------------------------------------------------------
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)/?$ /$1/index.html [L]
</IfModule>

# ------------------------------------------------------------
# 05. CORS & FAVICON ACCESS FOR CRAWLERS
# ------------------------------------------------------------
<FilesMatch "\.(ico|png|svg|json)$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# 06. ZERO-CACHE FOR HTML (Prevents Stale Cache in Edge / Chrome / CDN)
# ------------------------------------------------------------
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# 07. CACHING HEADERS FOR STATIC ASSETS
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/x-icon "access plus 1 hour"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
# 08. SECURITY HEADERS
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
